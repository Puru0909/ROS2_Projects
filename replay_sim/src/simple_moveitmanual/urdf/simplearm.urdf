<?xml version="1.0"?>
<robot name="simplearm">

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <!-- BASE -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.30"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.30"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.15"/>
      <inertia ixx="0.1" ixy="0" ixz="0"
               iyy="0.1" iyz="0"
               izz="0.05"/>
    </inertial>
  </link>

  <!-- LINK 1 -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.40"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.40"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.2"/>
      <inertia ixx="0.007" ixy="0" ixz="0"
               iyy="0.007" iyz="0"
               izz="0.001"/>
    </inertial>
  </link>

  <!-- LINK 2 -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.30"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.30"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.15"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0"
               izz="0.0005"/>
    </inertial>
  </link>

  <!-- LINK 3 — end rod -->
  <link name="link3">
    <visual>
      <!-- <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry> -->
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.48"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <!-- <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.20"/></geometry> -->
      <origin xyz="0 0 0.24" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.48"/></geometry>

    </collision>
    <!-- <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.1"/>
      <inertia ixx="0.0004" ixy="0" ixz="0"
               iyy="0.0004" iyz="0"
               izz="0.0001"/>
    </inertial> -->
     <inertial>
  <mass value="0.2"/>
  <origin xyz="0 0 0.245"/>
  <inertia ixx="0.0028" ixy="0" ixz="0"
           iyy="0.0028" iyz="0"
           izz="0.0001"/>
</inertial>


  </link>

  <link name="tcp"/>

  <!-- JOINTS -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="50" velocity="1.0"/>
  </joint>

  <!-- <joint name="ee_fixed" type="fixed">
    <parent link="link3"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
  </joint> -->

  <!-- tcp joint -->
<joint name="ee_fixed" type="fixed">
  <parent link="link3"/>
  <child link="tcp"/>
  <origin xyz="0 0 0.48" rpy="0 0 0"/>
</joint>
  <!-- ROS2 CONTROL -->
  <ros2_control name="SimpleArmSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="p">500.0</param>
      <param name="d">10.0</param>
      <param name="i">0.1</param>
      <param name="i_clamp">5.0</param>
      <param name="initial_position">0.0</param>
    </joint>

    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="p">500.0</param>
      <param name="d">10.0</param>
      <param name="i">0.1</param>
      <param name="i_clamp">5.0</param>
      <param name="initial_position">0.0</param>
    </joint>

    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <param name="p">500.0</param>
      <param name="d">10.0</param>
      <param name="i">0.1</param>
      <param name="i_clamp">5.0</param>
      <param name="initial_position">0.0</param>
    </joint>

  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control"
            filename="libgazebo_ros2_control.so">
      <parameters>/home/purushottam/Downloads/ROS2_Projects/replay_sim/install/simple_moveitmanual/share/simple_moveitmanual/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
