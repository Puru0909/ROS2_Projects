<?xml version="1.0"?>
<sdf version="1.6">
  <model name="highlight_zone">

    <static>true</static>

    <!-- Horizontal bar of T — along X axis, 0.20m wide -->
    <link name="horizontal_zone">
      <visual name="horizontal_visual">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.20 0.06 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.9 0.0 0.8</ambient>
          <diffuse>0.0 0.9 0.0 0.8</diffuse>
          <specular>0.0 0.5 0.0 0.6</specular>
          <emissive>0.0 0.4 0.0 1.0</emissive>
        </material>
        <transparency>0.3</transparency>
      </visual>
    </link>

    <!-- Vertical bar of T — stem goes along Y axis downward -->
    <!-- matches t_shape.urdf where stem is along Y -->
    <link name="vertical_zone">
      <pose>0 -0.125 0 0 0 0</pose>
      <visual name="vertical_visual">
        <pose>0 0 0.015 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.19 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.9 0.0 0.8</ambient>
          <diffuse>0.0 0.9 0.0 0.8</diffuse>
          <specular>0.0 0.5 0.0 0.6</specular>
          <emissive>0.0 0.4 0.0 1.0</emissive>
        </material>
        <transparency>0.3</transparency>
      </visual>
    </link>

    <joint name="t_zone_joint" type="fixed">
      <parent>horizontal_zone</parent>
      <child>vertical_zone</child>
    </joint>

  </model>
</sdf>